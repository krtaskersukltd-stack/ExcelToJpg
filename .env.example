# Python FastAPI Backend URL
# The browser uses the same-origin /api/py proxy by default.
# NEXT_PUBLIC_API_URL=https://converter-api.example.com

# Stripe Payment Gateway Keys
# Obtain your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51Pxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Pxxxxxxxxxxxxxxxxxxxxxxxxx
CONVERTER_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication (generate a long random value in production)
AUTH_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Google Identity Services (required for Google sign-in)
# Create a Web OAuth client ID in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Add your production domain and local development URL to Authorized JavaScript origins.
# These values must be the same Web OAuth client ID; the backend rejects a mismatch.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
